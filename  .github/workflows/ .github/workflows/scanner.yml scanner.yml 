name: Watchlist Discord Scanner

on:
  schedule:
    - cron: "7,22,37,52 13-21 * * 1-5"

  workflow_dispatch:
    inputs:
      force_report:
        description: "Send all current readings during market hours"
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: watchlist-scanner
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 12

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run watchlist scanner
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
          FORCE_REPORT: ${{ inputs.force_report || false }}
        run: python scanner.py

      - name: Save alert memory
        if: always()
        run: |
          if [ ! -f state.json ]; then
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add state.json

          if ! git diff --cached --quiet; then
            git commit -m "Save scanner alert state"
            git push
          fi
